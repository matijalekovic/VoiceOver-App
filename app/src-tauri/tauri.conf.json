{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1PAX Voice Studio",
  "version": "0.3.1",
  "identifier": "com.onepax.voicestudio",
  "build": {
    "beforeDevCommand": "bash ../scripts/prepare-bundle.sh && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && bash ../scripts/prepare-bundle.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "1PAX Voice Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.music",
    "shortDescription": "Local voice cloning and voiceover studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/uv"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMjdERjFGQTQ0QzI0QkEKUldTNkpFeWtIOThuTGFzeVdiYnpzSnozS2QwMVVaaXJCandLZ0QzNE9VT25nR2JqK0wwdDlhTTEK",
      "endpoints": [
        "https://github.com/matijalekovic/VoiceOver-App/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
